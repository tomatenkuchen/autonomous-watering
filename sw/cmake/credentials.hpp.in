#pragma once

#include <array>
#include <cstdint>

namespace credentials {

struct Server {
  std::array<std::uint8_t, 4> ip_address;
  std::uint16_t port;
};

struct Wifi {
  std::string ssid;
  std::string password;
};

// clang-format off

constexpr static Wifi wifi_credentials = {
    .ssid = @LOCAL_WIFI_SSID@,
    .password = @LOCAL_WIFI_PASSWORD@,
};

constexpr static Server server_config = {
    .ip_address = {@LOCAL_MQTT_BROKER_IP_0@, @LOCAL_MQTT_BROKER_IP_1@,
                   @LOCAL_MQTT_BROKER_IP_2@, @LOCAL_MQTT_BROKER_IP_3@},
    .port = @LOCAL_MQTT_BROKER_PORT@,
};

// clang-format on

} // namespace credentials
