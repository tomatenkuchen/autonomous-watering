#pragma once

#include <cstdint>
#include <string_view>

namespace version {

struct Version {
  uint8_t major;
  uint8_t minor;
  uint8_t patch;
  uint8_t tweak;
};

// clang-format off

constexpr static Version version = {
    .major = @CONAN_PROJECT_VERSION_MAJOR@,
    .minor = @CONAN_PROJECT_VERSION_MINOR@,
    .patch = @CONAN_PROJECT_VERSION_PATCH@,
    .tweak = @CONAN_PROJECT_VERSION_TWEAK@,
};

constexpr static std::string_view version_string = "@CONAN_PROJECT_VERSION@";
constexpr static std::string_view project_name = "@CONAN_PROJECT_NAME@";
constexpr static std::string_view project_description = "@CONAN_PROJECT_DESCRIPTION@";

// clang-format on

} // namespace version
